{{- /* PaperMod 검색 색인. 실습 페이지는 본문이 data.json에 있으므로 원고 문장(+주제 이름)을 content로 넣는다.
       lines·vocab·channel·tags·date·duration은 검색 결과 카드(layouts/search.html)가 쓴다 — 검색 대상 키는 아니다.
       테마의 .Scratch 대신 지역 변수 — 서버 재빌드마다 누적되지 않게. */ -}}
{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- $content := .Plain }}
    {{- $lines := slice }}{{ $vocab := slice }}{{ $channel := "" }}
    {{- with .Resources.Get "data.json" }}
        {{- $d := . | transform.Unmarshal }}
        {{- $ko := slice }}
        {{- range $d.sentences }}{{ $lines = $lines | append .text }}{{ range .chunks }}{{ $ko = $ko | append .ko }}{{ end }}{{ end }}
        {{- range $d.vocab }}{{ $vocab = $vocab | append (dict "term" .term "ko" .ko) }}{{ $ko = $ko | append .ko }}{{ end }}
        {{- $channel = $d.source_channel | default "" }}
        {{- /* 한국어 뜻(덩어리·어휘)도 넣어 '해일'처럼 우리말로 찾아도 걸리게 */}}
        {{- $content = printf "%s %s %s" (delimit $lines " ") (delimit $ko " ") $channel }}
    {{- end }}
    {{- /* 주제 이름도 넣어 주제로 찾아도 걸리게 */}}
    {{- $tags := slice }}
    {{- range .Params.tags }}{{ $t := partial "tag_name.html" . }}{{ $tags = $tags | append $t }}{{ $content = printf "%s %s %s" $content $t (title (replace . "-" " ")) }}{{ end }}
    {{- $index = $index | append (dict
        "title" .Title "content" $content "permalink" .Permalink "summary" (.Summary | plainify | htmlUnescape)
        "lines" $lines "vocab" $vocab "channel" $channel "tags" $tags "date" (.Date.Format "2006-01-02") "duration" (.Params.duration | default 0)) -}}
    {{- end }}
{{- end -}}
{{- $index | jsonify -}}
